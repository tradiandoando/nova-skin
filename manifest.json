{
  "manifest_version": 3,
  "name": "NOVA Skin",
  "version": "0.7.31",
  "description": "NOVA visual layer for ChatGPT.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NOVA Skin",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "css": [
        "nova.css",
        "themes/cosmic.css",
        "themes/aurora.css",
        "themes/mono.css",
        "themes/sunset.css",
        "themes/nova-light.css",
        "themes/cosmic-light.css",
        "themes/aurora-light.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}